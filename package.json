{
  "name": "@osrcmap/igp-huaicos",
  "version": "0.1.0",
  "description": "Estado en vivo de las quebradas que monitorea el IGP (huaicos y lahares en Lima, Piura, Arequipa y Huaraz) + CLI agent-first. Distingue activo, no activo y sin transmisión.",
  "type": "module",
  "license": "MIT",
  "author": "Oscar Macchiavello (https://github.com/osrcmap)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osrcmap/igp-huaicos.git"
  },
  "homepage": "https://github.com/osrcmap/igp-huaicos#readme",
  "bugs": "https://github.com/osrcmap/igp-huaicos/issues",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "peru",
    "igp",
    "huaico",
    "lahar",
    "monitoreo",
    "alerta-temprana",
    "cli",
    "el-nino"
  ],
  "bin": {
    "igp-huaicos": "dist/cli.js"
  },
  "files": [
    "dist",
    "SKILL.md",
    "LIMITATIONS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/bin.ts",
    "build": "bun build src/bin.ts --target=node --outfile dist/cli.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "prepublishOnly": "bun run typecheck && bun test && bun run build && node scripts/humo.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.3",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
